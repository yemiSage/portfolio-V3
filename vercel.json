{
  "trailingSlash": false,
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/projects/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/guestbook", "destination": "/guestbook/index.html" },
    {
      "source": "/projects/tasafrica",
      "destination": "/projects/tasafrica/index.html"
    },
    {
      "source": "/projects/limestone",
      "destination": "/projects/limestone/index.html"
    },
    {
      "source": "/projects/stayafrika",
      "destination": "/projects/stayafrika/index.html"
    },
    {
      "source": "/resume",
      "destination": "/resume/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
