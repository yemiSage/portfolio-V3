# .env.example
GEMINI_API_KEY=
GITHUB_TOKEN=
# Optional: Groq is used ahead of Gemini when set (free key at console.groq.com).
GROQ_API_KEY=

# Optional production Guestbook storage. Server-side only. Accepted notes publish immediately.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Guestbook email notifications, server-side only. Verify the sender with Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional sender display name (defaults to Yemi’s portfolio).
BREVO_SENDER_NAME=
